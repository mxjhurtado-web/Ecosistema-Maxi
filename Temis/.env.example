# TEMIS Environment Variables Example

# Google Cloud Service Account (JSON codificado en Base64) con acceso a Google Drive
TEMIS_GOOGLE_SA_BASE64=tu_service_account_base64_aqui

# ID de la carpeta destino en Google Drive (Shared Drive)
TEMIS_DRIVE_FOLDER_ID=1NA32b-o473ZxcpuLxHPf2xDOt5XHn2CI

# Google Gemini API Key
GEMINI_API_KEY=tu_gemini_api_key_aqui

# Modelo de Gemini
GEMINI_MODEL=gemini-2.5-flash

# Keycloak SSO (Opcional)
KEYCLOAK_URL=https://sso.maxilabs.net/auth
KEYCLOAK_REALM=zeusDev
KEYCLOAK_CLIENT_ID=maxi-business-ai
KEYCLOAK_CLIENT_SECRET=tu_keycloak_secret_aqui
KEYCLOAK_REDIRECT_URI=http://localhost:8080/callback
