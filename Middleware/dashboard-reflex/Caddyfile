{
    admin off
}

:{$PORT} {
    encode gzip

    # Route backend event handlers, uploads, and pings to the Reflex Python backend server
    @backend {
        path /_event /_event/* /ping /_upload /_upload/* /api/*
    }
    reverse_proxy @backend localhost:8000

    # Serve compiled static frontend assets
    root * /app/.web/build/client
    route {
        try_files {path} {path}/ /404.html
        file_server
    }
}
